# scripts/local.env: this machine's paths and MiSTer address; only the sample
# is committed
scripts/local.env*
!scripts/local.env.sample
build_*.log
build*.out

# Verilator simulation (sim/): generated Verilog, models, run output
sim/generated/
sim/obj_*/
sim/out/

# OpenBIOS out-of-tree build (scripts/build-bios.sh)
bios/build/


# Sun PROM images and anything reproduced from them: never commit
# (docs/VERILOG-PLAN.md 1.1; keep them in scratch/private/)
private/
scratch/
*.ROM
docs/rom-disassembly/*/listing.s
docs/rom-disassembly/*/forth-dictionary.txt
docs/rom-disassembly/*/forth-nodes.txt
docs/rom-disassembly/*/forth.json
docs/rom-disassembly/*/fcode-*.txt

# block testbench builds (rtl/tb/run.sh)
rtl/tb/obj/

# IU harness builds
sim/iu/obj/
# simulation builds and logs
sim/*/obj/
sim/*/obj_run.txt

# The OpenBIOS boot ROM of a test build: our GPL build from bios/ (never a Sun PROM)
!releases/boot.rom
